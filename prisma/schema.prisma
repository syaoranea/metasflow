// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/metasflow/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum GoalCategory {
  PESSOAL
  CARREIRA
  SAUDE
  FINANCAS
  ESTUDOS
  RELACIONAMENTOS
  LAZER
  ESPIRITUALIDADE
  IMPACTO_SOCIAL
  BENS_DE_CONSUMO
}

enum GoalPriority {
  ALTA
  MEDIA
  BAIXA
}

enum GoalStatus {
  EM_ANDAMENTO
  CONCLUIDA
  PAUSADA
}

model Goal {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  category    GoalCategory
  deadline    DateTime?
  priority    GoalPriority
  status      GoalStatus   @default(EM_ANDAMENTO)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  reflections Reflection[]

  @@index([userId])
  @@index([status])
  @@index([category])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  completed   Boolean  @default(false)
  order       Int      @default(0)
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Reflection {
  id            String   @id @default(cuid())
  whatWorked    String?  @db.Text
  whatDidntWork String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  goalId        String
  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}
